{
  "name": "webextreme-dev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "icons:export": "node --experimental-strip-types scripts/export-brand-icons.mjs",
    "dev": "nuxt dev --host 127.0.0.1 --port 3100",
    "build": "nuxt generate",
    "preview": "wrangler dev --ip 127.0.0.1 --port 3100",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "node --experimental-strip-types --test tests/contact.test.ts",
    "test:e2e": "playwright test",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "logo:export": "node --experimental-strip-types scripts/export-brand-logo.mjs"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "nuxt": "^4.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.0.0",
    "lighthouse": "^13.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vue-tsc": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
